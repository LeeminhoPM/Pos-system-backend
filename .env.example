# Environment Variables Configuration Example for POS System
# Copy this file to .env and configure your production values

# Application Server
SERVER_PORT=5000

# Database Credentials
DB_URL=jdbc:mysql://localhost:3307/pos_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=pos_prod_user
DB_PASSWORD=StrongProductionPassword_ReplaceMe!

# JWT Secret Key (Must be at least 256 bits / 32 characters for HMAC-SHA256, preferably 512 bits)
JWT_SECRET=super_secret_jwt_key_at_least_64_characters_for_hmac_sha512_security_pos_system
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (Comma-separated origins)
CORS_ALLOWED_ORIGINS=https://pos.yourcompany.com,http://localhost:5173

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_CURRENCY=vnd
