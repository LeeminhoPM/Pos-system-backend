# ========================================================
# SkyPOS Enterprise Environment Configuration
# Copy this file to .env and replace with your secrets
# ========================================================

# Application Core
SPRING_PROFILE=prod
SERVER_PORT=5000

# Database Credentials (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3307/pos_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=pos_system
DB_ROOT_PASSWORD=your_root_password_here

# Redis In-Memory Cache (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (HS512 - At least 64 characters)
JWT_SECRET=zntuceyczbzgazycopqqwvryithxbewcymywpyqcehlpgxzwowgmqsmizmvremjncvqxqrnjwoidanptqzxomilyhmeeclqobxjipuxzegyfrqxevrekglqkjgnhgnsmhaqofiycmqqgrpcnznebbyvajqclvqzw
JWT_EXPIRATION_MS=86400000

# Security & CORS Whitelist (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,https://pos.yourdomain.com

# Stripe Payment Gateway (Online Cards & Refunds)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_CURRENCY=vnd

# Mail Service (Optional - for order invoice receipts)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Logging & Monitoring
LOG_LEVEL=INFO
